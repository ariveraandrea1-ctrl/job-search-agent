# ============================================================
# job-search-agent — variables de entorno (Proyecto 1: local)
# Copiar a .env y completar los "changeme". NUNCA commitear el .env real.
# Guía completa: docs/runbooks/reconstruccion.md
# ============================================================

# --- Docker Compose ---
# Nombre del proyecto (prefijo de contenedores y volúmenes). Si levantas una
# SEGUNDA copia en el mismo computador (ej. para probar la reconstrucción),
# usa otro nombre para no tocar los volúmenes de la primera.
COMPOSE_PROJECT_NAME=job-search-agent
TZ=America/Bogota

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Clave para cifrar las credenciales de n8n. Genérala una vez
# (ej. `openssl rand -hex 32`) y NO la cambies: sin ella no se pueden leer
# las credenciales guardadas ni restaurar respaldos.
N8N_ENCRYPTION_KEY=changeme-generate-a-stable-random-key
# scripts/start-local.sh reemplaza N8N_HOST y WEBHOOK_URL por la URL del
# túnel de Cloudflare (Telegram necesita una URL pública).
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Bogota

# --- PostgreSQL (lo comparten n8n y profile-api) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_search_agent
POSTGRES_USER=job_search_agent
POSTGRES_PASSWORD=changeme

# --- MinIO (archivos originales de los CV) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme-al-menos-8-caracteres
MINIO_BUCKET=job-search-agent

# --- Mailpit (atrapa los correos en local: http://localhost:8025) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Telegram ---
# Token del bot (BotFather → /newbot).
TELEGRAM_BOT_TOKEN=changeme
# Telegram user id de la administradora: la migración 0011 la crea como
# admin, y recibe las alertas de errores. Se ve escribiéndole a @userinfobot.
ADMIN_TELEGRAM_USER_ID=

# --- IA (credenciales que crea scripts/importar-n8n.py) ---
# Groq (principal) y Gemini (respaldo). Ver docs/decisions/001.
GROQ_API_KEY=changeme
GEMINI_API_KEY=changeme
# Precios por millón de tokens [entrada, salida] para la telemetría de IA.
# Vacío = costo 0 (plan gratis). Ej: {"openai/gpt-oss-120b": [0.15, 0.60]}
AI_PRECIOS_JSON=

# --- Correo de entrada: alertas de LinkedIn/Indeed/Workana (radar-correo) ---
# Gmail con contraseña de aplicación; el flujo lee la etiqueta "Radar".
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Correo de salida: resumen diario ---
# En local va a Mailpit. En producción: SMTP real (docs/decisions/006).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
