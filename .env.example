# ============================================================
# job-search-agent — variables de entorno (Proyecto 1: local)
# Copiar a .env y completar. NUNCA commitear .env real.
# ============================================================

# --- Entorno ---
ENV=local
TZ=America/Bogota

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=changeme-generate-a-stable-random-key
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Bogota

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_search_agent
POSTGRES_USER=job_search_agent
POSTGRES_PASSWORD=changeme

# --- MinIO (objetos: CV, exports, artefactos) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=job-search-agent

# --- Mailpit (captura local de correos en desarrollo) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Telegram ---
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_ALLOWED_USER_IDS=
# Telegram user id de la administradora (se crea como admin en la migración 0011)
ADMIN_TELEGRAM_USER_ID=

# --- Correo (alertas de entrada / resumen diario) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Router de IA ---
# Alias usados por los workflows: fast, structured, reasoning, embedding
NVIDIA_NIM_API_KEY=changeme
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_USD=5

# --- Túnel opcional (webhooks en desarrollo) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Profile API ---
PROFILE_API_HOST=profile-api
PROFILE_API_PORT=8000
